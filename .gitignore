# Dependencias
node_modules/

# Build do Next
.next/
out/
build/

# Variaveis de ambiente — nenhum segredo real entra no repositorio (FR-023)
.env
.env.*
!.env.example

# Testes e medicoes
playwright-report/
test-results/
blob-report/
.lighthouseci/
coverage/

# Sistema operacional e editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.tmp
*.swp

# Estado local da ferramenta do Supabase (ref do projeto ligado, versoes dos
# servicos). Muda conforme a maquina de quem desenvolve, e nao descreve o projeto.
supabase/.temp/

# Cache de compilacao incremental do TypeScript: gerado a cada build,
# diferente em cada maquina, conflita em todo merge. Nao se versiona.
*.tsbuildinfo

# Declaracao de tipos gerada pelo Next. Esteve versionada desde o primeiro
# commit da F00 e saiu na recuperacao do RP-13, depois de medido que o `tsc`
# passa sem ela. Quem a regera e `next typegen`, encadeado em `verificar:tipos`
# — entao um clone novo a tem antes de qualquer verificacao precisar dela.
next-env.d.ts

# Skills do OpenSpec geradas em duplicata pelo `openspec init`: o mesmo conteudo
# vai para .claude/skills/, que e a pasta que o Claude Code le e a que fica
# versionada. Versionar as duas seria guardar o mesmo arquivo duas vezes e
# conflitar em todo merge (RP-13).
.agents/

# Instrucoes a agentes de IA que o `next dev` escreve quando detecta um agente na
# sessao. O `agentRules: false` do next.config.ts desliga isso; esta linha garante
# que, se o arquivo voltar, ele nao entra no Git sem decisao (Q4 (c) da
# endurecer-agentes-e-git-local, AS-17). Sem barra no comeco: pega qualquer pasta.
AGENTS.md
