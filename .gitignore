# Dependencias
node_modules/

# Build do Next
.next/
out/
build/

# Estado local da ferramenta da Vercel (projeto ligado, ids). Ainda nao e gerado
# aqui: entra ANTES de alguem rodar `vercel link`, porque no dia em que for
# gerado ninguem vai estar olhando.
.vercel/

# Variaveis de ambiente — nenhum segredo real entra no repositorio (FR-023)
.env
.env.*
!.env.example

# Testes e medicoes
playwright-report/
test-results/
blob-report/
playwright/.cache/
.lighthouseci/
coverage/

# Cache do ESLint. So e gerado com `eslint --cache`, que hoje nao usamos.
.eslintcache

# Sistema operacional e editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.tmp
*.swp

# Estado local da ferramenta do Supabase (ref do projeto ligado, versoes dos
# servicos). Muda conforme a maquina de quem desenvolve, e nao descreve o projeto.
supabase/.temp/
supabase/.branches/

# Cache de compilacao incremental do TypeScript: gerado a cada build,
# diferente em cada maquina, conflita em todo merge. Nao se versiona.
*.tsbuildinfo

# Declaracao de tipos gerada pelo Next. Esteve versionada desde o primeiro
# commit da F00 e saiu na recuperacao do RP-13, depois de medido que o `tsc`
# passa sem ela. Quem a regera e `next typegen`, encadeado em `verificar:tipos`
# — entao um clone novo a tem antes de qualquer verificacao precisar dela.
next-env.d.ts
