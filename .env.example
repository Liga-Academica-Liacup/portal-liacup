# Variaveis de ambiente do Portal LIACUP
#
# Copie este arquivo para `.env.local` e preencha os valores. O `.env.local` NAO
# entra no repositorio — o .gitignore cuida disso. Nenhum segredo real fica
# versionado aqui: este arquivo lista os NOMES e explica para que serve cada um.
#
# Na F00 nenhuma destas variaveis e usada ainda. Elas estao listadas desde ja para
# que ninguem descubra tarde o que vai precisar.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — entra na F02. Ainda NAO usado.
# ─────────────────────────────────────────────────────────────────────────────

# Endereco do projeto no Supabase. Pode aparecer no navegador: nao e segredo.
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica (anon). Vai para o navegador de proposito e depende da RLS estar
# ativa em toda tabela para ser segura. Tabela sem politica de acesso e bug.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servico. SEGREDO. Ignora a RLS e so pode existir no servidor.
# Nunca prefixar com NEXT_PUBLIC_: o prefixo publica a variavel no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Resend — envio de e-mail, entra na F13. Ainda NAO usado. Ver docs/ADR-0002.
# ─────────────────────────────────────────────────────────────────────────────

# Chave de API do Resend. SEGREDO. So no servidor.
RESEND_API_KEY=

# Remetente de tudo que e automatico. Sempre @liacup.com.br, NUNCA @gmail.com:
# enviar por servico externo com remetente @gmail.com reprova no DMARC do Google
# e a mensagem cai em spam ou e rejeitada.
EMAIL_REMETENTE=nao-responda@liacup.com.br

# Endereco de resposta das confirmacoes, encaminhado para liacup.unb@gmail.com.
EMAIL_RESPOSTA=contato@liacup.com.br
